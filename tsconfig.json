{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "WebWorker"], "strict": true, "noUncheckedIndexedAccess": false,
    "noEmit": true, "skipLibCheck": true, "esModuleInterop": true, "types": ["node"]
  },
  "include": ["packages/*/src", "tests", "scripts"]
}
